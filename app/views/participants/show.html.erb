<%= content_for :title, "Participants ##{@participant.id}" %>
<%= turbo_stream_from @participant %>

<div class="container px-4 mx-auto my-8">
  <div class="flex items-center justify-between mb-4">
    <h1 class="h3">
    
      <%= link_to "Participants", participants_path, class: "text-black dark:text-white" %>
      <span class="text-gray-400 font-light mx-2">\</span>
      Participant #<%= @participant.id %>
    </h1>

  <% if !@participant.approved %>
    <%= link_to "Edit your Information", edit_participant_path(@participant), class: "btn btn-primary" %>
  <% else %>
    <%= link_to "View your detailed information", participant_path(@participant), class: "btn btn-primary" %>
  <% end %>
    
  </div>

  <div class="p-8 bg-white dark:bg-gray-900 dark:border dark:border-gray-700 rounded shadow">
    <%= render @participant %>
  </div>
</div>
