<% if current_user.admin? %>
<%= content_for :title, "Participants" %>
<%= turbo_stream_from :participants %>

<div class="container px-4 mx-auto my-8">
  <div class="flex items-center justify-between mb-4">
    <h1 class="h3">Participants</h1>
    <div class="flex space-x-2">
      <%= link_to t("scaffold.new.title", model: "Participant"), new_participant_path, class: "btn btn-secondary" %>
      <%= link_to 'Export Participants', export_participants_path(format: :xlsx), class: 'btn btn-primary' %>
    </div>
  </div>

  <div class="table-responsive">
    <table id="participants-datatable" class="table table-striped w-full">
      <thead>
        <tr>
          <th>Roll Number</th>
          <th>Name</th>
          <th>Organization</th>
          <th>Registration Date</th>
          <th>Location</th>
          <th>Position</th>
          <th>Email</th>
          <th>Telephone</th>
          <th>Type</th>
          <th>Group</th>
          <th>Emergency Contact</th>
          <th>Emergency Phone</th>
          <th>Side Event</th>
          <th>Meal Options</th>
          <th>Material</th>
          <th>Accommodation</th>
          <th>Notes</th>
          <th>Actions</th>
        </tr>
      </thead>
      <tbody>
        <% @participants.each_with_index do |participant, index| %>
          <tr>
            <td><%= index + 1 %></td>
            <td><%= participant.name %></td>
            <td><%= participant.orgname %></td>
            <td><%= participant.registration_date %></td>
            <td><%= participant.location %></td>
            <td><%= participant.position %></td>
            <td><%= participant.email %></td>
            <td><%= participant.telephone_number %></td>
            <td><%= participant.participant_type_name %></td>
            <td><%= participant.group_name %></td>
            <td><%= participant.emergency_contact_name %></td>
            <td><%= participant.emergency_contact_number %></td>
            <td><%= participant.side_event_name %></td>
            <td><%= participant.meal_options %></td>
            <td><%= participant.resourceMaterial_take %></td>
            <td><%= participant.accommodation_required %></td>
            <td><%= participant.notes %></td>
            <td>
              <%= link_to 'Edit', edit_participant_path(participant), class: 'btn btn-sm btn-warning' %>
              <%= link_to 'Delete', participant, data: { turbo_method: :delete, turbo_confirm: 'Are you sure?' }, class: 'btn btn-sm btn-danger' %>
            </td>
          </tr>
        <% end %>
      </tbody>
    </table>
  </div>
</div>

<% else %>
  <div class="container my-4">
    <h2 class="text-center">Participant Registration</h2>
    <h3 class="text-center">Welcome, <strong><%= current_user.name %></strong>!</h3>
    
    <% participant = Participant.find_by(user_id: current_user.id) %>

    <% if participant.present? %>
      <div class="card mt-4 p-4 text-center">
        <% if participant.approved? %>
          <div class="alert alert-success">
            <h4><i class="fas fa-check-circle"></i> Congratulations! Your registration is approved.</h4>
            <p>You will receive an email about your badge soon. We look forward to seeing you!</p>
            <% if participant.hotel_allocated? %>
              <p>Hotel allocated: <strong><%= participant.hotel_name %></strong></p>
            <% else %>
              <p>Hotel is not yet allocated. You will be notified via email and on this page once it is confirmed.</p>
            <% end %>
          </div>
          <div class="mt-3">
            <%= link_to "View Your Information", participant_path(participant), class: "btn btn-info" %>
          </div>
        <% else %>
          <div class="alert alert-warning">
            <h4><i class="fas fa-clock"></i> Your registration is pending approval.</h4>
            <p>The ARM Coordinator will review your registration shortly. Please keep in touch for updates.</p>
            <small>Notice that once your registration is approved, you can't edit your participation information.</small>
          </div>
          <div class="mt-3">
            <%= link_to "View/Edit Your Information", edit_participant_path(participant), class: "btn btn-info" %>
          </div>
        <% end %>
      </div>
    <% else %>
      <div class="card mt-4 p-4 text-center">
        <div class="alert alert-danger">
          <h4>No Participant Information Found</h4>
          <p>You are not yet registered as a participant. Would you like to create one?</p>
        </div>
        <div class="mt-3">
          <%= link_to t("scaffold.new.title", model: "Participant"), new_participant_path(name: current_user.name, email: current_user.email), class: "btn btn-primary" %>
        </div>
      </div>
    <% end %>
  </div>
<% end %>

<script>
  // Wait for the DOM to be fully loaded
  document.addEventListener("DOMContentLoaded", function() {
    // Check if the table element exists before initializing
    if (document.getElementById('participants-datatable')) {
      new DataTable('#participants-datatable');
    }
  });
</script>