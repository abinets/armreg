<h1>Import Participants</h1>

<%= form_with url: import_participants_path, local: true, multipart: true do |form| %>
  <div>
    <%= form.label :file, "Upload CSV file" %>
    <%= form.file_field :file %>
  </div>

  <div>
    <%= form.submit "Import Participants" %>
  </div>
<% end %>

<%= link_to 'Back to Participants', participants_path %>