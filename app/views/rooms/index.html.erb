<%= content_for :title, "Rooms" %>
<%= turbo_stream_from :rooms %>

<div class="container px-4 mx-auto my-8">
  <div class="flex items-center justify-between mb-4">
    <h1 class="h3">Rooms</h1>
    <%= link_to t("scaffold.new.title", model: "Room"), new_room_path, class: "btn btn-secondary" %>
  </div>

  <div class="table-responsive">
    <table id="rooms-datatable" class="table table-striped w-full">
      <thead>
        <tr>
          <%# --- The Updated Column Order --- %>
          <th>Hotel</th>
          <th>Room Number</th>
          <th>Room Type</th>
          <th>Floor</th>
          <th>Status</th>
          <th>Actions</th>
        </tr>
      </thead>
      <tbody>
        <% @rooms.each do |room| %>
          <tr>
            <%# --- The Updated Column Order --- %>
            <td><%= room.hotel_name %></td>
            <td><%= room.room_number %></td>
            <td><%= room.room_type %></td>
            <td><%= room.floor %></td>
            
            <%# --- The Updated Status Column --- %>
 <td>
  <% if room.assigned? %>
    <%# This part only runs if the room's status is 'assigned' %>
    <span>Assigned</span>
    <br>
    <span>(<%= room.assigned_participant_info %>)</span>
  <% else %>
    <%# This part runs if the room's status is 'available' %>
    <span style="color: green;">Available</span>
  <% end %>
</td>
            <%# --- End Updated Status Column --- %>
            
            <td>
              <%= link_to "View", room, class: "btn btn-sm btn-info" %>
              <%= link_to "Edit", edit_room_path(room), class: "btn btn-sm btn-warning" %>
              <%= link_to "Delete", room, data: { turbo_method: :delete, turbo_confirm: "Are you sure?" }, class: "btn btn-sm btn-danger" %>
            </td>
          </tr>
        <% end %>
      </tbody>
    </table>
  </div>
</div>

<script>
  // Wait for the DOM to be fully loaded
  document.addEventListener("DOMContentLoaded", function() {
    // Check if the table element exists before initializing
    if (document.getElementById('rooms-datatable')) {
      new DataTable('#rooms-datatable');
    }
  });
</script>