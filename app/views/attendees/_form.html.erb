<%= form_with(model: attendee) do |form| %>
  <%= render "error_messages", resource: form.object %>

  <div class="form-group">
    <%= form.label :full_name %>
    <%= form.text_field :full_name, class: "form-control" %>
  </div>

  <div class="form-group">
    <%= form.label :address %>
    <%= form.text_field :address, class: "form-control" %>
  </div>

  <div class="form-group">
    <%= form.label :org %>
    <%= form.text_field :org, class: "form-control" %>
  </div>

  <div class="form-group">
    <%= form.label :days_to_attend %>
    <%= form.text_field :days_to_attend, class: "form-control" %>
  </div>

  <div>
    <%= form.button button_text(form.send(:submit_default_value)), class: "btn btn-primary" %>

    <% if form.object.new_record? %>
      <%= link_to t("cancel"), attendees_path, class: "btn btn-secondary" %>
    <% else %>
      <%= link_to t("cancel"), attendee_path(@attendee), class: "btn btn-secondary" %>
    <% end %>
  </div>
<% end %>
