<%= content_for :title, "Participant Types ##{@participant_type.id}" %>
<%= turbo_stream_from @participant_type %>

<div class="container px-4 mx-auto my-8">
  <div class="flex items-center justify-between mb-4">
    <h1 class="h3">
      <%= link_to "Participant Types", participant_types_path, class: "text-black dark:text-white" %>
      <span class="text-gray-400 font-light mx-2">\</span>
      Participant Type #<%= @participant_type.id %>
    </h1>
    <%= link_to t("edit"), edit_participant_type_path(@participant_type), class: "btn btn-secondary" %>
  </div>

  <div class="p-8 bg-white dark:bg-gray-900 dark:border dark:border-gray-700 rounded shadow">
    <%= render @participant_type %>
  </div>
</div>
