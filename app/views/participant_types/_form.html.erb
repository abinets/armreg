<%= form_with(model: participant_type) do |form| %>
  <%= render "error_messages", resource: form.object %>

  <div class="form-group">
    <%= form.label :type_name %>
    <%= form.text_field :type_name, class: "form-control" %>
  </div>

  <div class="form-group">
    <%= form.label :description %>
    <%= form.text_field :description, class: "form-control" %>
  </div>

  <div>
    <%= form.button button_text(form.send(:submit_default_value)), class: "btn btn-primary" %>

    <% if form.object.new_record? %>
      <%= link_to t("cancel"), participant_types_path, class: "btn btn-secondary" %>
    <% else %>
      <%= link_to t("cancel"), participant_type_path(@participant_type), class: "btn btn-secondary" %>
    <% end %>
  </div>
<% end %>
