<div class="badge-container" style="width: 324px; height: 504px; position: relative; overflow: hidden; background-image: url(<%= wicked_pdf_image_tag(image_name) %>); background-size: cover;">

  <div class="badge-body" style="text-align: left; padding-left: 20px; margin-top: 150px;">
    <h2 style="color:<%= text_color %>; margin: 0; font-weight: bold;"><%= @participant.name %></h2>
    <p style="margin: 0; font-size: 25px; color: <%= text_color %>;"><%= @participant.position %></p>
    <p style="margin: 0; font-size: 25px; color: <%= text_color %>; font-weight: bold;"><strong><%= @participant.orgname %></strong></p>
  </div>

  <div class="qr-code-and-serial" style="position: absolute; bottom: 50px; left: 20px; display: flex; align-items: flex-end; width: 100%;">
    <div style="flex: 1;">
      <img style="width: 100px; height: 100px;" src="https://api.qrserver.com/v1/create-qr-code/?data=http://armregistration.moh.gov.et:3000/participants/detailed/<%= @participant.serial_number %>&size=100x100" alt="QR Code" />
    </div>
    <div style="flex: 1; text-align: right; padding-right: 50px;">
      <p style="text-align: center;"> <strong style="color:<%= serial_color %>; margin: 0;"><%= @participant.serial_number %></strong></p>
    </div>
  </div>
</div>