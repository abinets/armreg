<%= content_for :title, "Side Events ##{@side_event.id}" %>
<%= turbo_stream_from @side_event %>

<div class="container px-4 mx-auto my-8">
  <div class="flex items-center justify-between mb-4">
    <h1 class="h3">
      <%= link_to "Side Events", side_events_path, class: "text-black dark:text-white" %>
      <span class="text-gray-400 font-light mx-2">\</span>
      Side Event #<%= @side_event.id %>
    </h1>
    <%= link_to t("edit"), edit_side_event_path(@side_event), class: "btn btn-secondary" %>
  </div>

  <div class="p-8 bg-white dark:bg-gray-900 dark:border dark:border-gray-700 rounded shadow">
    <%= render @side_event %>
  </div>
</div>
