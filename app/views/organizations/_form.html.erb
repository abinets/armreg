<%= form_with(model: organization) do |form| %>
  <%= render "error_messages", resource: form.object %>

  <div class="form-group">
    <%= form.label :name %>
    <%= form.text_field :name, class: "form-control" , maxlength: 25 %>
   <small style="color: gray;">Allowed max text length: 25 characters</small>
  </div>

  <div class="form-group">
    <%= form.label :location %>
    <%= form.text_field :location, class: "form-control" %>
  </div>

  <div class="form-group">
    <%= form.label :allowed_participant_number %>
    <%= form.number_field :allowed_participant_number, class: "form-control" %>
  </div>

  <div>
    <%= form.button button_text(form.send(:submit_default_value)), class: "btn btn-primary" %>

    <% if form.object.new_record? %>
      <%= link_to t("cancel"), organizations_path, class: "btn btn-secondary" %>
    <% else %>
      <%= link_to t("cancel"), organization_path(@organization), class: "btn btn-secondary" %>
    <% end %>
  </div>
<% end %>
