<%= form_with(model: @room_assignment, local: true) do |form| %>
  <% if @room_assignment.errors.any? %>
    <div id="error_explanation">
      <h2><%= pluralize(@room_assignment.errors.count, "error") %> prohibited this room assignment from being saved:</h2>
      <ul>
        <% @room_assignment.errors.full_messages.each do |message| %>
          <li><%= message %></li>
        <% end %>
      </ul>
    </div>
  <% end %>

  <div class="field">
    <%= form.label :participant_id %>
    <%= form.collection_select :participant_id, @participants, :id, :name, { selected: @room_assignment.participant_id },
      { 
        prompt: "Select a Participant",
        id: "participant-select",
        data: { 
          controller: "select",
          action: "change->select#filterRooms"
        } 
      } %>
  </div>

  <div class="field">
    <%= form.label :room_id %>
    <%= form.collection_select :room_id, @rooms, :id, :full_room_name, { selected: @room_assignment.room_id }, 
      { 
        prompt: "Select a Room",
        id: "room-select",
        data: { 
          controller: "select"
        } 
      } %>
  </div>

  <div class="field">
    <%= form.label :arrived_date %>
    <%= form.date_field :arrived_date, class: "form-control" %>
  </div>

  <div class="field">
    <%= form.label :checkin_date %>
    <%= form.date_field :checkin_date, class: "form-control" %>
  </div>

  <div class="field">
    <%= form.label :checkout_date %>
    <%= form.date_field :checkout_date, class: "form-control" %>
  </div>

  <div class="field">
    <%= form.label :notes %>
    <%= form.text_area :notes, class: "form-control" %>
  </div>

  <div>
    <%= form.button button_text(form.send(:submit_default_value)), class: "btn btn-primary" %>
    <%= link_to t("cancel"), room_assignments_path, class: "btn btn-secondary" %>
  </div>
<% end %>