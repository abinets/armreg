<%= content_for :title, "Room Assignments ##{@room_assignment.id}" %>
<%= turbo_stream_from @room_assignment %>

<div class="container px-4 mx-auto my-8">
  <div class="flex items-center justify-between mb-4">
    <h1 class="h3">
      <%= link_to "Room Assignments", room_assignments_path, class: "text-black dark:text-white" %>
      <span class="text-gray-400 font-light mx-2">\</span>
      Room Assignment #<%= @room_assignment.id %>
    </h1>
    <%= link_to t("edit"), edit_room_assignment_path(@room_assignment), class: "btn btn-secondary" %>
  </div>

  <div class="p-8 bg-white dark:bg-gray-900 dark:border dark:border-gray-700 rounded shadow">
    <%= render @room_assignment %>
  </div>
</div>
