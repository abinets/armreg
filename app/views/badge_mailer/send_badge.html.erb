
<div style="background-image: url('http://arm.moh.gov.et/wp-content/uploads/2024/10/badge223.png'); 
    background-size: cover; 
    background-position: center; /* Center the image */
    background-repeat: no-repeat; /* Prevent the image from repeating */
    border: 6px solid #1b71e0; /* Border properties */
    border-radius: 10px; 
    padding: 20px; 
    width: 337px; /* Example width */
    color: white; /* Optional: text color */
    text-align: center; /* Optional: center the text */
    "> 
      <div class="badge">
      <div>
      <img  src="http://arm.moh.gov.et/wp-content/uploads/2022/08/logomohnewww.png" alt="Logo" />
      
      <p style="text-align: center; color:black;">26th</p>
      <p style="text-align: center; color:black; ">ARM 2024</p>
      <p style="text-align: center; color:blue;">Annual Review Meeting</p>
      </div>

        <div class="badge-body">
          <p style="text-align: center; color:brown; margin: 0;"><%= @participant.name %></p>
           <p style="text-align: center; margin: 0;"><%= @participant.position %></p>
           <p style="text-align: center; color:black; margin: 0;"><strong><%= @participant.organization.name %></strong> </p>         
        </div>
        <div class="qr-code">
        <img style="text-align: center; bold; color:blue;" src="https://api.qrserver.com/v1/create-qr-code/?data=<%= @participant.serial_number %>&size=100x100" alt="QR Code" />
        </div>
        <div>
        <br /><p style="text-align: center;"> <strong style="color:brown; margin: 0;"><%= @participant.serial_number %></strong></p>
     </div>
      </div>
</div>