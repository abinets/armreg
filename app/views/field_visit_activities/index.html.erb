<%= content_for :title, "Field Visit Activities" %>
<%= turbo_stream_from :field_visit_activities %>

<div class="container px-4 mx-auto my-8">
  <div class="flex items-center justify-between mb-4">
    <div>
      <h1 class="h3">Field Visit Activities</h1>

      <div class="text-sm font-medium">
        <span class="text-gray-500 dark:text-gray-300/75">Sort by:</span>
        <%= sortable @field_visit_activities, :name, "Name", class: "text-gray-700 dark:text-gray-300 mr-1" %>
        <%= sortable @field_visit_activities, :description, "Description", class: "text-gray-700 dark:text-gray-300 mr-1" %>
        <%= sortable @field_visit_activities, :field_visit_area_id, "Field visit area", class: "text-gray-700 dark:text-gray-300 mr-1" %>
        <%= sortable @field_visit_activities, :scheduled_date, "Scheduled date", class: "text-gray-700 dark:text-gray-300 mr-1" %>
        <%= sortable @field_visit_activities, :duration, "Duration", class: "text-gray-700 dark:text-gray-300 mr-1" %>
        <%= sortable @field_visit_activities, :max_participants, "Max participants", class: "text-gray-700 dark:text-gray-300 mr-1" %>
        <%= sortable @field_visit_activities, :notes, "Notes", class: "text-gray-700 dark:text-gray-300 mr-1" %>
      </div>
    </div>

    <%= link_to t("scaffold.new.title", model: "Field Visit Activity"), new_field_visit_activity_path, class: "btn btn-secondary" %>
  </div>

  <%= tag.div id: ("field_visit_activities" if first_page?), class: "bg-white dark:bg-gray-900 dark:border dark:border-gray-700 rounded-md shadow p-6 space-y-8" do %>
    <%= render partial: "field_visit_activities/field_visit_activity", collection: @field_visit_activities, as: :field_visit_activity, cached: true %>

    <div class="hidden only:block text-center">
      <p class="mb-4 h3">Create your first Field Visit Activity</p>
      <%= link_to t("scaffold.new.title", model: "Field Visit Activity"), new_field_visit_activity_path, class: "btn btn-primary" %>
    </div>
  <% end %>

  <% if @pagy.pages > 1 %>
    <div class="my-6 text-center">
      <%== pagy_nav(@pagy) %>
    </div>
  <% end %>
</div>
